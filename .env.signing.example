# Copy this file to .env.signing and fill in your values.
# NEVER commit .env.signing to version control.

APPLE_SIGNING_IDENTITY="Developer ID Application: Your Name (XXXXXXXXXX)"
APPLE_ID="you@example.com"
APPLE_APP_SPECIFIC_PASSWORD="xxxx-xxxx-xxxx-xxxx"
APPLE_TEAM_ID="XXXXXXXXXX"

# Optional: directory where the final DMG is placed (default: ~/Desktop)
OUTPUT_DIR="$HOME/Desktop"
