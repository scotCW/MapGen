<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Sandbox required for Mac App Store and notarization with hardened runtime -->
  <key>com.apple.security.app-sandbox</key>
  <true/>

  <!-- File-picker access to any user-selected location -->
  <key>com.apple.security.files.user-selected.read-write</key>
  <true/>

  <!-- Save exported maps to Downloads without a picker every time -->
  <key>com.apple.security.files.downloads.read-write</key>
  <true/>

  <!-- Fetch map tiles and any future API calls -->
  <key>com.apple.security.network.client</key>
  <true/>

  <key>com.apple.security.network.server</key>
  <false/>
</dict>
</plist>
