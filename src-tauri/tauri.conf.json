{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hunting Map Generator",
  "version": "0.0.1",
  "identifier": "com.huntingmapgenerator.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "yarn dev",
    "beforeBuildCommand": "yarn build"
  },
  "app": {
    "windows": [
      {
        "title": "Hunting Map Generator",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Print-ready topographic hunting maps",
    "longDescription": "Generates print-ready topographic hunting maps as PDFs from public-domain government geographic data. Works fully offline once county data is downloaded. No accounts, no telemetry.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": null,
      "entitlements": "entitlements.plist"
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0"
        ],
        "section": "science",
        "priority": "optional"
      }
    },
    "windows": {
      "certificateThumbprint": null,
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"]
      }
    }
  }
}
